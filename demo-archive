#!/usr/bin/env bash
set -euo pipefail
out="."
if [[ ${1-} == "-o" ]]; then
    [[ $# == 2 ]] || { echo "Использование: $0 [-o unpackdir]" >&2; exit 2; }
    out=$2
elif (($# != 0)); then
    echo "Использование: $0 [-o unpackdir]" >&2
    exit 2
fi
mkdir -p "$out"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
sed '1,/^__ARCHIVE_BELOW__$/d' "$0" | base64 -d > "$tmp"
tar -xzf "$tmp" -C "$out"
exit 0
