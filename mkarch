#!/usr/bin/env bash
# Задача 5. Создание самораспаковывающегося архива.
set -euo pipefail
usage() { echo "Использование: $0 -d dir_path -n name" >&2; exit 2; }
source_dir=""
name=""
while getopts ':d:n:' opt; do
    case $opt in
        d) source_dir=$OPTARG ;;
        n) name=$OPTARG ;;
        *) usage ;;
    esac
done
[[ -n $source_dir && -d $source_dir && -n $name ]] || usage
[[ $name != */* ]] || { echo "Имя архива должно быть именем файла в текущем каталоге." >&2; exit 2; }
command -v tar >/dev/null && command -v base64 >/dev/null || { echo "Нужны tar и base64." >&2; exit 1; }

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
tar -C "$source_dir" -czf "$tmp" .
{
cat <<'HEADER'
#!/usr/bin/env bash
set -euo pipefail
out="."
if [[ ${1-} == "-o" ]]; then
    [[ $# == 2 ]] || { echo "Использование: $0 [-o unpackdir]" >&2; exit 2; }
    out=$2
elif (($# != 0)); then
    echo "Использование: $0 [-o unpackdir]" >&2
    exit 2
fi
mkdir -p "$out"
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
sed '1,/^__ARCHIVE_BELOW__$/d' "$0" | base64 -d > "$tmp"
tar -xzf "$tmp" -C "$out"
exit 0
__ARCHIVE_BELOW__
HEADER
base64 -w 76 "$tmp"
} > "$name"
chmod a+x "$name"
echo "Создан самораспаковывающийся архив: $name"
